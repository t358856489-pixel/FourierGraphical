{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "persisted-function.schema.json",
  "title": "FourierFunction (persisted, schemaVersion 1)",
  "description": "保存在浏览器 IndexedDB 中的傅立叶函数. 运行时由等价的 Zod schema 校验; 本文件是该 schema 的规范性描述. JSON Schema 无法表达的约束(关键帧按 time 严格递增、组件 id 唯一)写在 description 中, 由 Zod 的 refine 实现.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schemaVersion", "name", "components", "presentationMode", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "components": {
      "type": "array",
      "maxItems": 50,
      "description": "各元素的 id 必须互不相同.",
      "items": { "$ref": "#/$defs/component" }
    },
    "presentationMode": { "enum": ["waveform", "drawing2d"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "amplitude", "frequency", "phase", "enabled", "color"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "amplitude": { "$ref": "#/$defs/track", "description": "所有 value 必须在 [0, 100] 内." },
        "frequency": { "$ref": "#/$defs/track", "description": "所有 value 必须在 [-100, 100] 内, 单位 圈/秒." },
        "phase": { "$ref": "#/$defs/track", "description": "所有 value 必须在 [-3600, 3600] 内, 单位 度." },
        "enabled": { "type": "boolean" },
        "color": { "type": "string", "pattern": "^c([0-9]|1[0-1])$" }
      }
    },
    "track": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "constant" },
            "value": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "keyframes"],
          "properties": {
            "kind": { "const": "animated" },
            "keyframes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "description": "必须按 time 严格递增.",
              "items": { "$ref": "#/$defs/keyframe" }
            }
          }
        }
      ]
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "value", "easing"],
      "properties": {
        "time": { "type": "number", "minimum": 0, "description": "秒; 写入前量化到 0.001. 不用 multipleOf 表达, 因为浮点数下该校验不可靠." },
        "value": { "type": "number" },
        "easing": { "enum": ["linear", "smooth", "hold"] }
      }
    }
  }
}
